# Saisir les secrets dans Coolify. Ne pas committer de .env réel.
# Reprendre les identifiants de config_db.php ; garder le mot de passe hors Git.
GLPI_DB_HOST=bdd.alexandre-lb.fr
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpidb
